{
  "name": "@tletelieru/name-formatter",
  "version": "0.1.1",
  "description": "Format and split person names, with first-class support for Spanish and Portuguese conventions.",
  "license": "MIT",
  "author": "tletelieru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tletelieru/name-formatter.git"
  },
  "keywords": [
    "name",
    "format",
    "split",
    "normalize",
    "surname",
    "spanish",
    "portuguese"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "node node_modules/eslint/bin/eslint.js --fix",
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{json,md,yml,yaml}": "node node_modules/prettier/bin/prettier.cjs --write"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^9.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
